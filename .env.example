PROJECTS_CONFIG=./config/projects.yaml
MCP_TRANSPORT=stdio
# HTTP: http; bind loopback locally, 0.0.0.0 in Docker
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact origins only; absent Origin is allowed for non-browser MCP clients.
MCP_ALLOWED_ORIGINS=
# Required for HTTP; file must contain at least 32 characters.
MCP_AUTH_TOKEN_FILE=./secrets/mcp-bearer.txt
# Required for encrypted OAuth tokens; 64 hex characters (32 random bytes).
TOKEN_ENCRYPTION_KEY_FILE=./secrets/token-key.txt
# For OAuth-only clients such as ChatGPT, use an external OAuth authorization server.
MCP_AUTH_MODE=bearer
# MCP_AUTH_MODE=oauth
# MCP_RESOURCE_URL=https://mcp.example.com/mcp
# MCP_OAUTH_ISSUER=https://login.example.com/
# MCP_OAUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# MCP_OAUTH_SCOPE=mcp:read
